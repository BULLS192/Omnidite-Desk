{
  "manifest_version": 3,
  "name": "Omnidite Desk — Personal Dashboard",
  "short_name": "Omnidite Desk",
  "version": "0.5.2",
  "description": "Omnidite Desk personal dashboard with local Pulse monitoring, optional Windows background-service controls and productivity workspaces.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Omnidite Desk side panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://*.omnidite.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}

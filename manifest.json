{
  "manifest_version": 3,
  "name": "Omnidite Desk — Personal Dashboard",
  "short_name": "Omnidite Desk",
  "version": "0.6.0",
  "description": "Omnidite Desk with widgets-first layout, live Calendar, Weather + PSI/AQI, and local Pulse.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging",
    "favicon",
    "identity"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Omnidite Desk side panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://api-open.data.gov.sg/*"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*",
    "https://*.omnidite.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "684614265374-0pc5kroqbbcprb7710u1nmfrr8r1frrh.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  }
}
